# Database (Supabase / Neon / any Postgres)
# If using Vercel ↔ Supabase integration, POSTGRES_URL is enough (app falls back to it).
DATABASE_URL=postgresql://user:password@host:5432/postgres
# POSTGRES_URL=...
# POSTGRES_URL_NON_POOLING=...

# Vercel AI Gateway
AI_GATEWAY_API_KEY=vgw_xxx

# Admin session signing secret (random long string)
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
